{
  "name": "filenet",
  "type": "module",
  "version": "0.1.4",
  "packageManager": "pnpm@12.14.0",
  "description": "Serve a single file over raw TCP in chunks to many clients at once",
  "author": "Mori <itsmori@tutamail.com>",
  "license": "MIT",
  "homepage": "https://github.com/moriloop/filenet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moriloop/filenet.git"
  },
  "bugs": {
    "url": "https://github.com/moriloop/filenet/issues"
  },
  "keywords": [
    "network",
    "network utility",
    "file server",
    "file transfer"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*",
        "./dist/index.d.ts"
      ]
    }
  },
  "bin": {
    "filenet": "./dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "start": "unbuild && node dist/cli.mjs",
    "build": "unbuild",
    "dev": "unbuild --stub",
    "lint": "eslint .",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "cz": "cz",
    "commit": "cz",
    "release": "release-it"
  },
  "dependencies": {
    "citty": "^0.1.6",
    "cli-progress": "^3.12.0",
    "consola": "^3.2.3",
    "read-chunk": "^4.0.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^2.15.0",
    "@commitlint/cli": "^18.6.1",
    "@commitlint/config-conventional": "^18.6.3",
    "@types/cli-progress": "^3.11.5",
    "@types/node": "^20.12.7",
    "@vitest/coverage-v8": "^1.5.0",
    "changelogen": "^0.5.5",
    "commitizen": "^4.3.0",
    "cspell": "^8.7.0",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^8.57.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.2",
    "release-it": "^17.2.0",
    "release-it-beautiful-changelog": "^0.1.1",
    "typescript": "^5.4.5",
    "unbuild": "^2.0.0",
    "vitest": "^1.5.0"
  },
  "lint-staged": {
    "*.{js,cjs,mjs,ts,mts,cts,vue,yml}": "eslint --fix",
    "*": "cspell --no-summary --no-progress"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}

{
  "name": "filenet",
  "type": "module",
  "version": "0.2.1",
  "packageManager": "pnpm@12.14.0",
  "description": "Serve a single file over raw TCP or UDP in chunks to many clients at once",
  "author": "Mori <itsmori@tutamail.com>",
  "license": "MIT",
  "homepage": "https://github.com/moriloop/filenet#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/moriloop/filenet.git"
  },
  "bugs": {
    "url": "https://github.com/moriloop/filenet/issues"
  },
  "keywords": [
    "network",
    "network utility",
    "file server",
    "file transfer"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "filenet": "./dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "start": "pnpm build && node dist/cli.js",
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json",
    "dev": "node scripts/clean.mjs && tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "lint": "eslint .",
    "prepublishOnly": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "cz": "cz",
    "commit": "cz",
    "release": "release-it"
  },
  "dependencies": {
    "citty": "^0.2.2",
    "cli-progress": "^3.12.0",
    "consola": "^3.4.2",
    "read-chunk": "^5.0.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^10.0.0",
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@types/cli-progress": "^3.11.6",
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "changelogen": "^0.6.2",
    "commitizen": "^4.3.2",
    "cspell": "^10.4.1",
    "cz-conventional-changelog": "^3.3.0",
    "eslint": "^10.14.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "release-it": "^21.1.2",
    "release-it-beautiful-changelog": "^0.2.1",
    "typescript": "^6.0.3",
    "vitest": "^5.1.0"
  },
  "lint-staged": {
    "*.*": "eslint --fix"
  },
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  }
}

{
  "git": {
    "commitMessage": "chore: release v${version}",
    "tagAnnotation": "Release v${version}",
    "requireBranch": "main"
  },
  "github": {
    "release": true,
    "releaseName": "Release v${version}"
  },
  "hooks": {
    "before:init": ["git pull", "pnpm lint"]
  },
  "plugins": {
    "release-it-beautiful-changelog": {
      "changelogFile": "./CHANGELOG.md"
    }
  }
}
